<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BenchmarkDotNet requires public benchmark types and members. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator is benchmarked as a library here, not run as an analyzer. -->
    <ProjectReference Update="@(ProjectReference)"
                      OutputItemType=""
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
